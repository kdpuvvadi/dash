{
	email {$CADDY_EMAIL}
}

# dns.puvvadi.net is split-horizon BIND (not a Cloudflare zone).
# ACME DNS-01 is aliased into the public puvvadi.net zone:
#   CF: _acme-challenge.dash.dns  CNAME  dash-acme.puvvadi.net
dash.dns.puvvadi.net {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		dns_challenge_override_domain dash-acme.puvvadi.net
		propagation_delay 2m
		resolvers 1.1.1.1
	}
	reverse_proxy 127.0.0.1:8080
}
