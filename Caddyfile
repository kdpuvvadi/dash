{
	email {$CADDY_EMAIL}
	acme_dns cloudflare {
		api_token {env.CLOUDFLARE_API_TOKEN}
	}
}

(tls_resolvers) {
	tls {
		resolvers 10.10.10.10
	}
}

# Apex zone exists in Cloudflare.
puvvadi.net {
	import tls_resolvers
	respond "ok" 200
}

# App host on the puvvadi.net zone (dns.puvvadi.net is not a CF zone — skip until it is).
dash.puvvadi.net {
	import tls_resolvers
	reverse_proxy dash:8080
}
