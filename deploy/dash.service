[Unit]
Description=Dash homelab metrics hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dash
Environment=DASH_CONFIG=/opt/dash/config
ExecStart=/opt/dash/dash serve -config /opt/dash/config
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
