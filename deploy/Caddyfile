# Kept in sync with root Caddyfile (server copies Caddyfile next to compose.yaml).
{
	email {$CADDY_EMAIL}
	acme_dns cloudflare {
		api_token {env.CLOUDFLARE_API_TOKEN}
	}
}

(tls_resolvers) {
	tls {
		resolvers 10.10.10.10
	}
}

puvvadi.net {
	import tls_resolvers
	respond "ok" 200
}

dash.puvvadi.net {
	import tls_resolvers
	reverse_proxy dash:8080
}
