# Copy to .env on the server and fill in real values.
# Do not commit .env.

# GitHub Container Registry owner (org or user)
GITHUB_OWNER=kdpuvvadi

# Image tag to pull
DASH_TAG=latest

# Cloudflare API token for Let's Encrypt DNS-01.
# Create at https://dash.cloudflare.com/profile/api-tokens
# Permissions (both required):
#   Zone → Zone → Read
#   Zone → DNS → Edit
# Zone Resources: include the zone that holds the name
#   (for dash.dns.puvvadi.net that is usually zone "puvvadi.net")
CLOUDFLARE_API_TOKEN=

# Contact email for Let's Encrypt / ZeroSSL
CADDY_EMAIL=admin@puvvadi.net
