# Copy to .env on the server and fill in real values.
# Do not commit .env.

# GitHub Container Registry owner (org or user)
GITHUB_OWNER=kdpuvvadi

# Image tag to pull
DASH_TAG=latest

# Cloudflare API token with Zone:DNS:Edit for the zone that holds dash.dns.puvvadi.net
CLOUDFLARE_API_TOKEN=

# Optional contact email for ACME / Let's Encrypt
CADDY_EMAIL=admin@puvvadi.net
